# TMC API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Required before using protected API routes.
# Generate a long random value; never expose it in browser JavaScript.
TMC_API_TOKEN=

# Redis-compatible queue (e.g. managed Redis/Valkey).
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (Cloudflare R2 works here).
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Upload limits and signed upload URL lifetime.
MAX_UPLOAD_BYTES=2000000000
UPLOAD_URL_TTL_SECONDS=600
